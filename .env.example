# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://justheadz.xyz

# Connect X (OAuth 2.0). Callback URL to register in the X developer portal:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Long random string that signs sessions
SESSION_SECRET=

# Google Sheet database: deploy apps-script/Code.gs as a web app (steps are at the top of that file).
# When set, it is used instead of Upstash.
GOOGLE_SHEET_URL=

# Upstash Redis (alternative to the Sheet): needed for one-wallet-per-account across users and the CSV export.
# Without a Sheet or Upstash, each visitor's progress lives in a signed cookie in their browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /api/admin/export?key=ADMIN_KEY downloads every application as CSV
ADMIN_KEY=
