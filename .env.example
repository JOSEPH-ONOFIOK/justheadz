# Public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://justheadz.xyz

# Connect X (OAuth 2.0). Callback URL to register in the X developer portal:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Long random string that signs sessions
SESSION_SECRET=

# Upstash Redis: needed for one-wallet-per-account across users and the CSV export.
# Without it, each visitor's progress lives in a signed cookie in their browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /api/admin/export?key=ADMIN_KEY downloads every application as CSV
ADMIN_KEY=

# Who may apply (defaults: 90 days, 50 followers)
MIN_ACCOUNT_DAYS=90
MIN_FOLLOWERS=50
